# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly set file types
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.md text
*.sql text
*.yml text
*.yaml text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.zip binary
*.gz binary
